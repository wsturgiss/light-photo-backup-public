NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional in development only. Production derives this from PUBLIC_BASE_URL.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback
TOKEN_ENCRYPTION_KEY_BASE64=
DATABASE_PATH=./data/photo-backup.sqlite
PAIRING_TTL_SECONDS=600
PAIRING_POLL_INTERVAL_SECONDS=5
DEVICE_TOKEN_TTL_DAYS=365
TRUST_PROXY=false
